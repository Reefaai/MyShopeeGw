<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MyShopeeGw">

        <!-- 1. Layar Splash Screen (Launcher) -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Layar Login / Register -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3, 4, 11: MainActivity (Hosts Beranda, Kategori, Profil) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Layar Daftar Produk (Katalog & Search) -->
        <activity
            android:name=".ui.product.ProductListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6. Layar Detail Produk -->
        <activity
            android:name=".ui.product.ProductDetailActivity"
            android:exported="false" />

        <!-- 7. Layar Keranjang Belanja -->
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false" />

        <!-- 8. Layar Checkout Pesanan -->
        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 9. Layar Pembayaran Sandbox -->
        <activity
            android:name=".ui.checkout.PaymentSandboxActivity"
            android:exported="false" />

        <!-- 10. Layar Tracking Pesanan -->
        <activity
            android:name=".ui.tracking.OrderTrackingActivity"
            android:exported="false" />

        <!-- 12. Layar Ulasan Produk -->
        <activity
            android:name=".ui.review.ReviewListActivity"
            android:exported="false" />

    </application>

</manifest>
